{
  "name": "kyro-v4",
  "private": true,
  "version": "4.0.0-alpha.11",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint app-v4/src app-v4/tests scripts functions vite.config.ts playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check app-v4/src app-v4/tests app-v4/e2e functions/*.js functions/*.mjs functions/package.json scripts package.json firebase.json eslint.config.js vite.config.ts playwright.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:emulator:auth": "firebase emulators:exec --only auth --project demo-kyro-v4 \"node scripts/auth-emulator-test.mjs\"",
    "test:e2e:auth": "firebase emulators:exec --only auth --project demo-kyro-v4 \"node scripts/auth-e2e-runner.mjs\"",
    "test:emulator:rules": "firebase emulators:exec --only firestore,storage --project demo-kyro-v4 \"node scripts/firebase-rules-test.mjs\"",
    "test:emulator:functions": "firebase emulators:exec --only auth,firestore,storage,functions --project demo-kyro-v4 \"pnpm --dir functions test:emulator\""
  },
  "dependencies": {
    "firebase": "^12.2.1",
    "idb": "^8.0.3",
    "zod": "^4.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.25.1",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
